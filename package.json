{
  "name": "@opoha/plugin-sample",
  "version": "1.1.0",
  "description": "Teaching sample — custom store-notes plugin (GraphQL, admin, events, jobs, plugin-owned TypeORM)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "opoha.plugin.json"
  ],
  "opoha": {
    "id": "sample",
    "version": "1.1.0",
    "contractVersion": "0.1",
    "entry": "dist/index.js",
    "displayName": "Sample Notes",
    "description": "Teaching custom plugin — store notes with GraphQL, admin, events, jobs, and plugin-owned tables",
    "dependsOn": [],
    "required": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opoha/plugin-sdk": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opoha/typescript-config": "^1.0.0",
    "@opoha/vitest-config": "^1.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@11.7.0"
}
